# ================================================================
# FMS Environment Variables (Example)
# ================================================================
# Copy this to .env and fill in your values

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=auth_service_db

# --- JWT ---
JWT_SECRET=your-secret-key-here

# --- Service Ports ---
API_GATEWAY_PORT=3001

# --- gRPC URLs ---
USER_GRPC_URL=localhost:50051
FARM_GRPC_URL=localhost:50052
TASKS_GRPC_URL=localhost:50053
PRODUCTION_GRPC_URL=localhost:50054
STOCK_GRPC_URL=localhost:50055
REPORTS_GRPC_URL=localhost:50056

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
